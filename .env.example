# Variáveis de ambiente do lector-site
#
# Uso local:
#   cp .env.example .env      # preencha os valores reais no .env (ignorado pelo git)
#   node --env-file=.env devserver.js
#
# Na Vercel: configure as mesmas chaves em
#   Project → Settings → Environment Variables
#
# NUNCA commite o .env — o .gitignore já bloqueia .env e .env.*


# ─── Formulário de contato (api/contact.js) ──────────────────────────────────
# Conta Gmail usada como remetente (também aparece no campo "From").
EMAIL_USER=seu-email@gmail.com

# Senha de app do Gmail (16 caracteres, gerada em
# https://myaccount.google.com/apppasswords com verificação em 2 etapas ativa).
# Não é a senha normal da conta.
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Destinatário(s) das mensagens do formulário.
# Aceita vários endereços separados por vírgula.
EMAIL_TO=comercial@lector.com.br


# ─── Banco de leads (api/_lib/leads-db.js) ───────────────────────────────────
# Todo envio dos formulários do site é gravado na tabela leads_site
# (crie com db/schema.sql) e aparece em /admin › Relatórios › Leads site.
# Sem banco configurado, os formulários continuam só enviando e-mail.
#
# DB_PROVIDER escolhe o banco: postgres | supabase. Vazio = deduz pelas variáveis abaixo.
DB_PROVIDER=

# Opção A — PostgreSQL (Huawei Cloud RDS, Postgres local, ou o Postgres do Supabase):
# Senha com caracteres especiais vai codificada na URL (@ → %40, # → %23).
# Ex.: DATABASE_URL=postgresql://usuario:senha@host:5432/lector
DATABASE_URL=
# SSL: disable | require (padrão fora de localhost; criptografa sem validar o certificado) | verify
DATABASE_SSL=
# Só com DATABASE_SSL=verify e certificado próprio (ex.: CA da Huawei), PEM com \n nas quebras:
# DATABASE_SSL_CA=

# Opção B — Supabase pela API REST (Project Settings → API).
# A service_role (ou secret key sb_secret_…) é chave de SERVIDOR: nunca use prefixo VITE_/NEXT_PUBLIC_.
# Ex.: SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ─── Login do admin (/admin) ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@lectortec.com
ADMIN_PASSWORD=troque-esta-senha
# Segredo que assina o cookie de sessão (32+ caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=


# ─── Dev server (devserver.js) ───────────────────────────────────────────────
# Porta do servidor local. Padrão: 4321.
PORT=4321

# MAIL_DRY_RUN=1 desativa o envio real: o e-mail é apenas logado no console
# e as variáveis EMAIL_* acima passam a ser opcionais.
# Ideal para testar os formulários sem credenciais SMTP.
MAIL_DRY_RUN=1
