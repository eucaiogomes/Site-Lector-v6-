# OS
.DS_Store
Thumbs.db

# Dumps acidentais na raiz (mídia de produção → assets/media/<slug>/)
/*.mp4
/*.mov
/*.webm

# Downloads e arquivos compactados que caem em assets/ por engano.
# O GitHub rejeita qualquer arquivo acima de 100 MB.
*.dmg
*.pkg
*.exe
*.zip
*.tar
*.tar.gz
*.tgz

# Editors / agents
.idea/
.vscode/
*.swp
.cursor/
.claude/
.codex/
.grok/

# Dependencies
node_modules/
.bun/
dist/
build/
.next/
.out/
.cache/
.vercel

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# References = inspiração local (não produção; dumps pesados)
references/inspiration/
references/raw/
references/prototypes/

# Thumbnails gerados
**/.thumbnail
