[Unit]
Description=Site Lector — API Node (Bitnami)
After=network.target

[Service]
Type=simple
User=bitnami
WorkingDirectory=/opt/bitnami/projects/lector-site
ExecStart=/opt/bitnami/node/bin/node server.js
Restart=always
RestartSec=3

Environment=NODE_ENV=production
Environment=PORT=3000

# Credenciais: arquivo fora do site, root:root, chmod 600.
# É aqui que EMAIL_USER / EMAIL_PASS / EMAIL_TO são lidos.
EnvironmentFile=/etc/lector-site.env

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lector-site

[Install]
WantedBy=multi-user.target
