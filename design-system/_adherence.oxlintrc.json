        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|neutral|success|danger|info|warning)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'neutral' | 'success' | 'danger' | 'info' | 'warning'."
