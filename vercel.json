{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pages/home/index.dc.html" },
    { "source": "/home", "destination": "/pages/home/index.dc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.dc\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
